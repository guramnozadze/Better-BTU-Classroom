{
  "manifest_version": 3,
  "name": "Better BTU Classroom, BTU+ Plus | Downloads, Schedule, GPA & Progress Bar",
  "version": "0.7.0",
  "description": "BTU exclusive classroom - Speed up BTU course selection by showing only courses offered this semester, hide failed classes, Download all materials with 1 click, get a compact schedule table, semester GPA, and barrier progress bar",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "better-btu-classroom@example.com",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "https://classroom.btu.edu.ge/ge/student/me/courses",
        "https://classroom.btu.edu.ge/en/student/me/courses",
        "https://classroom.btu.edu.ge/ge/student/me/course/scores/*/*",
        "https://classroom.btu.edu.ge/ge/student/me/index/*",
        "https://classroom.btu.edu.ge/en/student/me/course/scores/*/*",
        "https://classroom.btu.edu.ge/ge/student/card",
        "https://classroom.btu.edu.ge/en/student/card",
        "https://classroom.btu.edu.ge/ge/student/me/schedule",
        "https://classroom.btu.edu.ge/en/student/me/schedule",
        "https://classroom.btu.edu.ge/ge/student/me/course/files/*/*",
        "https://classroom.btu.edu.ge/en/student/me/course/files/*/*",
        "https://classroom.btu.edu.ge/en/student/me/index/*"
      ]
    }
  ]
}
